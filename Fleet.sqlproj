<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  <PropertyGroup>
    <Name>tk2_Asset</Name>
    <ProjectGuid>{33894DC6-8CE3-4ADC-B823-331464B8A8BF}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".vscode\tasks.json" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="dbo\Scripts\PostDeployment\PostDeployment.sql" />
    <None Include="dbo\Scripts\Utility*" />
    <None Include="dbo\Scripts\PostDeployment\Data\zzz_test.sql" />
  </ItemGroup>
  <ItemGroup>
    <ArtifactReference Include="references\Shared.dacpac">
		<HintPath>references\Shared.dacpac</HintPath>
		<SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
		<SameDatabase>True</SameDatabase>
	</ArtifactReference>
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>